{
  "name": "@lern/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "migration:run": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env ../../node_modules/typeorm/cli.js migration:run -d dist/shared/database/data-source.js",
    "migration:revert": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env ../../node_modules/typeorm/cli.js migration:revert -d dist/shared/database/data-source.js",
    "migration:generate": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env ../../node_modules/typeorm/cli.js migration:generate -d dist/shared/database/data-source.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/typeorm": "11.0.3",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "11.2.7",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
