# Copy to .env (git-ignored). Values match infra/docker/compose.yml (dev only).
DATABASE_URL=postgres://lern:lern@127.0.0.1:5434/lern
REDIS_URL=redis://127.0.0.1:6379
# dev = logs and accepts 000000; telegram = real codes via Telegram Gateway (needs the token below)
OTP_PROVIDER=dev
# Dev only; generate a real one with: openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-not-for-any-deploy
# From gateway.telegram.org → account settings. Secret: never commit a real one
# TELEGRAM_GATEWAY_TOKEN=
# dev = logs pushes and sends nothing; fcm = real pushes through Firebase (needs the path below)
PUSH_PROVIDER=dev
# Firebase console → Project settings → Service accounts → Generate new private key.
# Absolute path to that JSON file, kept outside this repo. Secret: never commit the file
# FIREBASE_SERVICE_ACCOUNT_PATH=
# Staff web admin (/admin/*). Off by default; when on, STAFF_MFA_PROVIDER is required (dev = no second factor,
# refused when NODE_ENV=production). ADMIN_COOKIE_SECURE=false only for local http (refused in production)
# ADMIN_ENABLED=true
# STAFF_MFA_PROVIDER=dev
# ADMIN_COOKIE_SECURE=false
# STAFF_MFA_PROVIDER=duo needs a Duo "Web SDK" application's keys, its API hostname (no https://) and the admin page
# Duo returns the browser to (https in production):
# DUO_CLIENT_ID=
# DUO_CLIENT_SECRET=
# DUO_API_HOST=api-XXXXXXXX.duosecurity.com
# DUO_REDIRECT_URL=http://localhost:5173/admin/mfa/callback
