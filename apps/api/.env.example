# Copy to .env (git-ignored). Values match infra/docker/compose.yml (dev only).
DATABASE_URL=postgres://lern:lern@127.0.0.1:5432/lern
REDIS_URL=redis://127.0.0.1:6379
# dev = logs and accepts 000000; telegram = real codes via Telegram Gateway (needs the token below)
OTP_PROVIDER=dev
# Dev only; generate a real one with: openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-not-for-any-deploy
# From gateway.telegram.org → account settings. Secret: never commit a real one
# TELEGRAM_GATEWAY_TOKEN=
