{
  "name": "lern",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "pnpm --filter @lern/mobile start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm -r test:integration",
    "infra:up": "infra/docker/osrm/prepare.sh && docker compose -f infra/docker/compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker/compose.yml down",
    "sim": "pnpm --filter @lern/simulator build && pnpm --filter @lern/simulator start"
  }
}
